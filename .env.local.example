# polaris-oracle REST API base URL (market reads, odds, positions).
NEXT_PUBLIC_ORACLE_URL=http://localhost:3001
# Soroban RPC endpoint Freighter-signed trades are simulated and sent to.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Stellar network passphrase; must match the RPC's network.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Optional: market contract id shown in the landing page's "Try it live" section.
NEXT_PUBLIC_FEATURED_MARKET_ID=
